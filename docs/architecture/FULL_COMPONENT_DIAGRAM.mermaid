    %% ==================== RELATIONSHIPS ====================

    %% Entry Points
    App --> AuthProvider
    App --> DASHBOARDS
    App --> SALES
    App --> PROJECTS
    App --> PRODUCTION
    App --> INVENTORY

    PWAApp --> WorkerAuthContext
    PWAApp --> PWA_FLOOR

    ManagerApp --> ManagerAuthContext
    ManagerApp --> PWA_MANAGER

    %% Auth Flow
    AuthProvider --> Login
    WorkerAuthContext --> WorkerPinLogin
    WorkerAuthContext --> workerAuthService

    %% Dashboard Dependencies
    VPDashboard --> vpService
    VPDashboard --> QuoteDetail
    VPDashboard --> ProductionLine

    DirectorDashboard --> ProjectsList
    DirectorDashboard --> KanbanBoard

    PMDashboard --> ProjectDetails
    PMDashboard --> WorkflowCanvas
    PMDashboard --> TasksView

    PlantManagerDash --> ProductionLine
    PlantManagerDash --> TaktTimeTracker
    PlantManagerDash --> QueueTimeMonitor
    PlantManagerDash --> AttendanceDashboard
    PlantManagerDash --> CrewScheduleView
    PlantManagerDash --> QCInspectionModal

    SalesDashboard --> QuoteList
    SalesDashboard --> SalesPipeline

    SalesManagerDash --> SalesPipeline
    SalesManagerDash --> QuoteList

    %% Sales Component Flow
    QuoteList --> QuoteDetail
    QuoteList --> QuoteForm
    QuoteDetail --> QuoteForm
    QuoteDetail --> ProjectForm
    CustomerList --> CustomerForm
    CustomerList --> CustomerDetail
    DealerList --> DealerForm

    %% Project Component Flow
    ProjectsList --> ProjectDetails
    ProjectDetails --> PROJECT_TABS
    ProjectDetails --> KanbanBoard
    ProjectDetails --> WorkflowCanvas
    OverviewTab --> ModuleDetailModal

    %% Production Component Flow
    ProductionLine --> StationBox
    StationBox --> ModuleCard
    StationBox --> StationDetailModal
    ModuleCard --> ModuleDetailModal
    StationDetailModal --> QCInspectionModal
    ModuleDetailModal --> QCInspectionModal

    %% PWA Floor App Flow
    PWAShell --> PWAHome
    PWAHome --> ModuleLookup
    PWAHome --> QCInspection
    PWAHome --> StationMove
    PWAHome --> InventoryReceiving
    ModuleLookup --> modulesService
    QCInspection --> qcService
    StationMove --> stationService
    InventoryReceiving --> inventoryReceiptsService

    %% PWA Manager App Flow
    ManagerShell --> ManagerDashboard
    ManagerDashboard --> ManagerProjectsList
    ManagerProjectsList --> ManagerProjectDetail
    ManagerProjectDetail --> ManagerTasksView
    ManagerProjectDetail --> ManagerRFIsView

    %% Service Dependencies
    stationService --> supabaseClient
    modulesService --> supabaseClient
    workersService --> supabaseClient
    qcService --> supabaseClient
    efficiencyService --> supabaseClient
    vpService --> supabaseClient
    purchaseOrdersService --> supabaseClient
    inventoryReceiptsService --> supabaseClient
    workerAuthService --> supabaseClient

    %% Production to Services
    TaktTimeTracker --> efficiencyService
    QueueTimeMonitor --> modulesService
    OEECalculator --> efficiencyService
    KaizenBoard --> efficiencyService
    AttendanceDashboard --> workersService
    CrewScheduleView --> workersService
    CrossTrainingMatrix --> workersService

    %% Inventory to Services
    PurchaseOrderList --> purchaseOrdersService
    InventoryReceiptList --> inventoryReceiptsService

    %% Styling
    classDef entry fill:#10b981,stroke:#059669,color:#fff
    classDef auth fill:#a855f7,stroke:#7c3aed,color:#fff
    classDef dashboard fill:#3b82f6,stroke:#1d4ed8,color:#fff
    classDef sales fill:#3b82f6,stroke:#1d4ed8,color:#fff
    classDef project fill:#22c55e,stroke:#16a34a,color:#fff
    classDef production fill:#f97316,stroke:#ea580c,color:#fff
    classDef pwa fill:#06b6d4,stroke:#0891b2,color:#fff
    classDef inventory fill:#eab308,stroke:#ca8a04,color:#000
    classDef service fill:#64748b,stroke:#475569,color:#fff
    classDef shared fill:#94a3b8,stroke:#64748b,color:#000

    class App,PWAApp,ManagerApp entry
    class AuthProvider,WorkerAuthContext,ManagerAuthContext,Login,WorkerPinLogin auth
    class VPDashboard,DirectorDashboard,PMDashboard,PlantManagerDash,SalesDashboard,SalesManagerDash dashboard
    class QuoteList,QuoteForm,QuoteDetail,CustomerList,CustomerForm,CustomerDetail,DealerList,DealerForm,SalesPipeline sales
    class ProjectsList,ProjectDetails,ProjectForm,OverviewTab,TasksView,MilestonesView,RFIsView,SubmittalsView,ChangeOrdersView,LogsView,ColorSelectionsView,KanbanBoard,WorkflowCanvas project
    class ProductionLine,StationBox,ModuleCard,StationDetailModal,ModuleDetailModal,QCInspectionModal,TaktTimeTracker,QueueTimeMonitor,OEECalculator,KaizenBoard,DefectTimer,CrewUtilizationHeatmap,CrossTrainingMatrix,VisualLoadBoard,AttendanceDashboard,CrewScheduleView production
    class PWAShell,PWAHome,ModuleLookup,QCInspection,StationMove,InventoryReceiving,PWAProfile,ManagerShell,ManagerDashboard,ManagerProjectsList,ManagerProjectDetail,ManagerTasksView,ManagerRFIsView pwa
    class PurchaseOrderList,PurchaseOrderForm,InventoryReceiptList,LongLeadItems inventory
    class stationService,modulesService,workersService,qcService,efficiencyService,vpService,purchaseOrdersService,inventoryReceiptsService,validationService,workerAuthService,supabaseClient service
    class PageHeader,DataTable,Modal,FormField,StatusBadge,LoadingSpinner,EmptyState,Tabs,Card shared

        CustomerList["CustomerList.jsx"]
        CustomerForm["CustomerForm.jsx"]
        CustomerDetail["CustomerDetail.jsx"]
        DealerList["DealerList.jsx"]
        DealerForm["DealerForm.jsx"]
        SalesPipeline["SalesPipeline.jsx"]

        PlantManagerDash["PlantManagerDashboard.jsx<br/>Factory Operations"]
        SalesDashboard["SalesDashboard.jsx<br/>Sales Rep View"]
        SalesManagerDash["SalesManagerDashboard.jsx<br/>Sales Manager View"]

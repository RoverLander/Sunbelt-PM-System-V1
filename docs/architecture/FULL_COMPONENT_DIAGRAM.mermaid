    subgraph ENTRY["🚀 Entry Points"]
        App["App.jsx<br/>Main Router"]
        PWAApp["PWAApp.jsx<br/>Floor Worker Entry"]
        ManagerApp["ManagerApp.jsx<br/>Manager Mobile Entry"]
    end

    subgraph AUTH["🔐 Authentication"]
        AuthProvider["AuthProvider.jsx"]
        WorkerAuthContext["WorkerAuthContext.jsx<br/>PIN-based Auth"]
        ManagerAuthContext["ManagerAuthContext.jsx<br/>Email/Password Auth"]
        Login["Login.jsx"]
        WorkerPinLogin["WorkerPinLogin.jsx"]
    end

    subgraph DASHBOARDS["📊 Dashboards"]

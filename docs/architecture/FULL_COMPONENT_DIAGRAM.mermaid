%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#3b82f6', 'lineColor': '#64748b'}}}%%

graph TB
    %% ============================================================================
    %% SUNBELT PM SYSTEM - FULL COMPONENT DEPENDENCY DIAGRAM
    %% 148 Components | Color-Coded by Domain
